# Build-time only: used by npm run snapshot:catalog, never shipped to the browser.
FRESA_CATALOG_API_URL=https://fresaai.app/api/public/v1/tasks
FRESA_CATALOG_API_KEY=replace-with-a-rotated-fresa-catalog-key
FRESA_CATALOG_SOURCES=[{"listId":"replace-with-list-id","name":"Texas","activeFieldId":"replace-with-active-field-id"}]
# Optional override for local/staging. Production defaults to Fresa's scoped,
# anonymous Esfenix catalog integration; no browser API key is required.
VITE_FRESA_CATALOG_PUBLIC_URL=
# Optional public form override. The production form is used when empty.
VITE_FRESA_QUOTE_FORM_URL=

# Server-side live active-client lookup configuration. These values are read
# by Firebase Functions parameters; never prefix the API key with VITE_ and
# never put it in a browser environment file.
FRESA_CLIENTS_API_URL=https://fresaai.app/api/public/v1/tasks
FRESA_CLIENTS_LIST_ID=20cd5f18-e350-492f-97db-fc52b45461bf
FRESA_CLIENTS_EMAIL_FIELD_ID=385ea80b-dafe-498a-a153-1d83419149f7
FRESA_CLIENTS_ACTIVE_FIELD_ID=e25c3417-f03a-4a32-9809-85951e015a41
# FRESA_CLIENTS_API_KEY is set in Firebase Secret Manager, not here.
# Optional local browser override when the Functions emulator is running:
VITE_FRESA_CLIENT_LOOKUP_URL=/api/fresa-client-lookup
