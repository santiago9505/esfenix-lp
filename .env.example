# Build-time only: used by npm run snapshot:catalog, never shipped to the browser.
FRESA_CATALOG_API_URL=https://fresaai.app/api/public/v1/tasks
FRESA_CATALOG_API_KEY=replace-with-a-rotated-fresa-catalog-key
FRESA_CATALOG_SOURCES=[{"listId":"replace-with-list-id","name":"Texas","activeFieldId":"replace-with-active-field-id"}]
# Optional override for local/staging. Production defaults to Fresa's scoped,
# anonymous Esfenix catalog integration; no browser API key is required.
VITE_FRESA_CATALOG_PUBLIC_URL=
# Optional public form override. The production form is used when empty.
VITE_FRESA_QUOTE_FORM_URL=
# Public URL of the Cloudflare Worker that performs the exact-email lookup.
# This URL is safe for the browser; the Fresa key is a Worker secret.
VITE_FRESA_CLIENT_LOOKUP_URL=

# Server-side only. Configure this value with `wrangler secret put`; never use
# a VITE_ prefix or place the real value in this file.
FRESA_CLIENTS_API_KEY=replace-with-a-rotated-fresa-clients-key
